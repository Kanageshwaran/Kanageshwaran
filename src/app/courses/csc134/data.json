  "queries": [
    "SELECT SSN, First_Name, Last_Name\nFROM STUDENT\nWHERE SSN IN (\n    SELECT SSN\n    FROM ENROLLS\n    WHERE CourseNo = (SELECT CourseNo FROM COURSE WHERE Course_Name = 'Computer Architecture')\n);",
    "SELECT S.SSN, S.First_Name, S.Last_Name, E.CourseNo, E.SectionNo\nFROM STUDENT S\nJOIN ENROLLS E ON S.SSN = E.SSN\nWHERE E.CourseNo = (SELECT CourseNo FROM COURSE WHERE Course_Name = 'VLSI');",
    "SELECT C.Course_Name, C.CourseNo\nFROM COURSE C\nJOIN ENROLLS E ON C.CourseNo = E.CourseNo\nGROUP BY C.Course_Name, C.CourseNo\nHAVING COUNT(DISTINCT E.SSN) >= 2;",
    "SELECT S.SSN, S.First_Name, S.Last_Name\nFROM STUDENT S\nJOIN TAKES T ON S.SSN = T.SSN\nWHERE T.Result >= 90\nGROUP BY S.SSN, S.First_Name, S.Last_Name\nHAVING COUNT(T.ExamNo) >= 2;",
    "SELECT C.CourseNo, C.SectionNo, C.ExamNo, CR.RoomNo, CR.Building, CR.Capacity\nFROM CONDUCTED_IN C\nJOIN CLASS_ROOM CR ON C.RoomNo = CR.RoomNo AND C.Building = CR.Building\nWHERE CR.Building = 'Riverside Hall';",
    "SELECT S.SSN, S.First_Name, S.Last_Name\nFROM STUDENT S\nJOIN ENROLLS E ON S.SSN = E.SSN\nWHERE E.CourseNo IN (\n    SELECT CourseNo\n    FROM COURSE\n    WHERE Course_Name IN ('Programming I', 'Programming II')\n);",
    "SELECT C.Course_Name, COUNT(S.SectionNo) AS Num_Sections\nFROM COURSE C\nJOIN SECTION S ON C.CourseNo = S.CourseNo\nGROUP BY C.Course_Name\nHAVING COUNT(S.SectionNo) > 2;",
    "SELECT CR.Building, CR.RoomNo, CR.Capacity, C.CourseNo, C.SectionNo, C.ExamNo\nFROM CLASS_ROOM CR\nLEFT JOIN CONDUCTED_IN C ON CR.RoomNo = C.RoomNo AND CR.Building = C.Building\nWHERE CR.Building = 'RVR';"
  ],
